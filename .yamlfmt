---
{
  # KYAML formatter (KEP 5295 dialect): flow-style maps/lists, double-quoted
  # strings, trailing commas. See https://kubernetes.io/blog/2026/08/11/
  # how-to-pretty-print-kubernetes-yaml-as-kyaml/ for the rationale.
  formatter: {
    type: "kyaml",
  },
  # App-input data files (not K8s manifests) keep the upstream format.
  exclude: [
    "vox/qwen3_tts.yaml",
  ],
  # Vendored chart sources under gitignored charts/ are third-party; without
  # this, `yamlfmt -lint .` fails decoding their Go templates.
  gitignore_excludes: true,
}
