# Copy to values-secret.yaml (gitignored) and fill in real values.
harborAdminPassword: CHANGE_ME

# Random strings; keep identical across upgrades. xsrfKey must be 32 chars.
secretkey: CHANGE_ME_16_CHARS
core:
  secret: CHANGE_ME_16_CHARS
  secretKey: CHANGE_ME_16_CHARS
  xsrfKey: CHANGE_ME_32_CHARS
  # Token-service signing keypair (PEM) — pinned so every render is identical
  # (the chart's autogenerated cert changes on every apply otherwise).
  # Regenerate with:
  #   openssl req -x509 -newkey rsa:4096 -nodes -keyout token.key -out token.crt \
  #     -days 3650 -subj "/CN=harbor-token-ca"
  tokenKey: |
    -----BEGIN PRIVATE KEY-----
    CHANGE_ME
    -----END PRIVATE KEY-----
  tokenCert: |
    -----BEGIN CERTIFICATE-----
    CHANGE_ME
    -----END CERTIFICATE-----
jobservice:
  secret: CHANGE_ME_16_CHARS

# Fixed registry auth. htpasswdString must be a bcrypt hash of the password
# (the chart's htpasswd function salts differently on each render):
#   htpasswd -bnBC 10 <username> <password>
registry:
  secret: CHANGE_ME_16_CHARS
  credentials:
    username: harbor_registry_user
    password: CHANGE_ME
    htpasswdString: "harbor_registry_user:$2y$10$CHANGE_ME"

# Password for the "harbor" PostgreSQL role (must match db-setup.sh).
database:
  external:
    password: CHANGE_ME
