# Copy to .env-operator-admin (gitignored) and fill in real values. Generate
# passwords with:
#   openssl rand -base64 24
# Key names are fixed (username / password) by the Keycloak CR's
# bootstrapAdmin.user.secret schema. This is the dedicated master-realm
# admin: the operator login and the cluster-rebuild bootstrap credentials.
username=keycloak-operator
password=CHANGE_ME
