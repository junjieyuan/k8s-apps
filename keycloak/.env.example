# Copy to .env (gitignored) and fill in real values. Generate passwords with:
#   openssl rand -base64 24
# The bootstrap admin user is created on first startup only.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Password for the "keycloak" PostgreSQL role (must match db-setup.sh).
KC_DB_PASSWORD=CHANGE_ME
